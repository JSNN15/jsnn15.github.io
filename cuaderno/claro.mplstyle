# Estilo de los gráficos del cuaderno, tema claro. Colores comprobados contra la superficie #fcfcfb.
figure.facecolor: fcfcfb
axes.facecolor: fcfcfb
savefig.facecolor: fcfcfb
figure.figsize: 9, 3.1
figure.dpi: 144
savefig.dpi: 144
font.family: DejaVu Sans
font.size: 9.5
text.color: 0c141a
axes.labelcolor: 52514e
axes.titlecolor: 0c141a
axes.titlesize: 10.5
axes.titleweight: bold
axes.titlelocation: left
axes.titlepad: 10
axes.edgecolor: c3c2b7
axes.linewidth: 0.8
axes.spines.top: False
axes.spines.right: False
axes.grid: True
axes.axisbelow: True
grid.color: e1e0d9
grid.linewidth: 0.6
grid.linestyle: -
xtick.color: 6f6e69
ytick.color: 6f6e69
xtick.labelsize: 8.5
ytick.labelsize: 8.5
xtick.major.size: 0
ytick.major.size: 0
lines.linewidth: 1.5
lines.solid_capstyle: round
axes.prop_cycle: cycler('color', ['2a78d6', 'eb6834', '1baf7a', 'eda100'])
legend.frameon: False
legend.fontsize: 8.5
figure.constrained_layout.use: True
date.autoformatter.day: %d-%m
date.autoformatter.hour: %d-%m %H:%M
date.autoformatter.minute: %H:%M
